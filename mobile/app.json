{
  "expo": {
    "name": "Catalysts",
    "slug": "catalysts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "catalysts",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Catalysts to turn your spoken questions into text.",
        "NSMicrophoneUsageDescription": "Allow Catalysts to listen when you tap the Catalyst Core."
      }
    },
    "android": {
      "package": "com.tcmfoundation.catalysts",
      "adaptiveIcon": {
        "backgroundColor": "#070B10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070B10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#070B10",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#B8F66A"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Catalysts to listen when you tap the Catalyst Core.",
          "speechRecognitionPermission": "Allow Catalysts to turn your spoken questions into text."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b274c57b-9dc5-4d01-adb4-1192b0e663fd"
      }
    },
    "owner": "muktar001"
  }
}
