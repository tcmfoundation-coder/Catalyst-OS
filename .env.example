# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/catalysts

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Object storage (S3-compatible) for uploaded study materials.
# For local development, run `npm run dev:storage` (starts a real
# S3-compatible server on disk via s3rver — dev/test only, never deploy it)
# and use the values below as-is.
S3_ENDPOINT=http://localhost:4568
S3_REGION=us-east-1
S3_BUCKET=catalysts-materials
S3_ACCESS_KEY_ID=S3RVER
S3_SECRET_ACCESS_KEY=S3RVER
S3_FORCE_PATH_STYLE=true

# Path to the Python interpreter inside processor/.venv (see processor/README.md).
# Defaults to processor/.venv/bin/python3 if unset and that path exists,
# otherwise falls back to "python3" on PATH.
PROCESSOR_PYTHON_BIN=

# Embeddings & vector search (see src/lib/retrieval/ and
# processor/processor/embedding/) — both optional, sensible defaults for
# local development.
# Where the local embedding model's weights are cached (defaults to
# processor/.cache/fastembed).
EMBEDDING_MODEL_CACHE_DIR=
# Where the persistent HNSW vector index file is stored (defaults to
# ./.vector-index in the project root).
VECTOR_INDEX_DIR=

# AI orchestration (see src/lib/ai/) — required for AIOrchestrator.ask()
# to actually generate an answer; retrieval/context assembly work without
# it. Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=
