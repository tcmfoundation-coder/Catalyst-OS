# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/catalysts

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Object storage (S3-compatible) for uploaded study materials.
# For local development, run `npm run dev:storage` (starts a real
# S3-compatible server on disk via s3rver — dev/test only, never deploy it)
# and use the values below as-is.
S3_ENDPOINT=http://localhost:4568
S3_REGION=us-east-1
S3_BUCKET=catalysts-materials
S3_ACCESS_KEY_ID=S3RVER
S3_SECRET_ACCESS_KEY=S3RVER
S3_FORCE_PATH_STYLE=true

# Path to the Python interpreter inside processor/.venv (see processor/README.md).
# Defaults to processor/.venv/bin/python3 if unset and that path exists,
# otherwise falls back to "python3" on PATH.
PROCESSOR_PYTHON_BIN=
