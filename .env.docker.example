MONGO_INITDB_ROOT_USERNAME=catalysts
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-long-url-safe-password
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Required for study-material uploads; point these at an S3-compatible bucket.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=catalysts-materials
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional: choose one server-side provider for AI responses.
# Gemini's free-tier terms may allow submitted content to improve products.
# Use synthetic or non-sensitive content when testing with a free-tier key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=high
# For Anthropic instead, set LLM_PROVIDER=anthropic and provide its key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=high
# For OpenAI instead, set LLM_PROVIDER=openai and provide its API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=medium
