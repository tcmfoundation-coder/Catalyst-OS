MONGO_INITDB_ROOT_USERNAME=catalysts
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-long-url-safe-password
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Required for study-material uploads; point these at an S3-compatible bucket.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=catalysts-materials
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional: required to generate AI responses.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=high
